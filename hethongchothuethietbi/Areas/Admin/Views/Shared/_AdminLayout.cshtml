<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar {
            background: #2c3e50;
            min-height: 100vh;
            padding-top: 20px;
        }
        .sidebar a {
            color: #ecf0f1;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            transition: 0.3s;
        }
        .sidebar a:hover, .sidebar a.active {
            background: #34495e;
            border-left: 4px solid #3498db;
        }
        .content-area {
            padding: 30px;
        }
        .navbar-admin {
            background: #34495e;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 sidebar">
                <h4 class="text-light px-3 mb-4"><i class="bi bi-gear-fill"></i> 
                    @(User.IsInRole("Admin") ? "Admin Panel" : "Staff Panel")
                </h4>

                <!-- Chỉ Admin xem được các menu quản lý -->
                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    <a href="@Url.Action("Index", "Category", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Category" ? "active" : "")">
                        <i class="bi bi-tag"></i> Quản lý danh mục
                    </a>
                    <a href="@Url.Action("Index", "Equipment", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Equipment" ? "active" : "")">
                        <i class="bi bi-box-seam"></i> Quản lý kho
                    </a>
                    <a href="@Url.Action("Index", "User", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "User" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> Quản lý tài khoản
                    </a>
                    <a href="/hangfire" target="_blank">
                        <i class="bi bi-clock-history"></i> Background Jobs
                    </a>
                }
                else if (User.IsInRole("Staff"))
                {
                    <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                }

                <!-- Both Admin & Staff xem được đơn hàng -->
                <a href="@Url.Action("Index", "Order", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Order" ? "active" : "")">
                    <i class="bi bi-receipt"></i> Quản lý đơn hàng
                </a>

                <!-- Settings -->
                <a href="@Url.Action("ChangePassword", "Settings", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear"></i> Đổi mật khẩu
                </a>

                <hr class="bg-secondary">
                <form method="post" action="@Url.Action("Logout", "Account", new { area = "" })" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link text-light px-3" style="text-decoration: none;">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </form>
            </div>

            <!-- Content -->
            <div class="col-md-9 content-area">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>@ViewBag.Title</h2>
                    <span class="badge bg-primary">@User.Identity.Name</span>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
