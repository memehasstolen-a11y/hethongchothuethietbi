@model List<RentalOrder>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>Danh sách đơn hàng</h3>
    <select class="form-select w-auto" onchange="location.href='@Url.Action("Index")?orderStatus=' + this.value;">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="PendingPayment">Chờ thanh toán</option>
        <option value="Deposited">Đã cọc</option>
        <option value="Rented">Đang thuê</option>
        <option value="Completed">Hoàn tất</option>
        <option value="Cancelled">Hủy</option>
    </select>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày tạo</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>#@order.Id</strong></td>
                    <td>@order.Customer.FullName</td>
                    <td>@order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        @{
                            var badgeColor = order.OrderStatus switch
                            {
                                RentalOrderStatus.PendingPayment => "warning",
                                RentalOrderStatus.Deposited => "info",
                                RentalOrderStatus.Rented => "primary",
                                RentalOrderStatus.Completed => "success",
                                RentalOrderStatus.Cancelled => "danger",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@badgeColor">@order.OrderStatus.ToString()</span>
                    </td>
                    <td>
                        <a href="@Url.Action("Detail", new { id = order.Id })" class="btn btn-sm btn-info">
                            <i class="bi bi-eye"></i> Chi tiết
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-inbox"></i> Không có đơn hàng nào
    </div>
}
