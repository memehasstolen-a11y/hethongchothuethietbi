@model RentalOrder

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Bàn giao thiết bị - Đơn #@Model.Id</h5>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-6">
                <h6>Thông tin khách hàng</h6>
                <dl class="row">
                    <dt class="col-sm-5">Tên:</dt>
                    <dd class="col-sm-7">@Model.Customer.FullName</dd>

                    <dt class="col-sm-5">Điện thoại:</dt>
                    <dd class="col-sm-7">@Model.Customer.PhoneNumber</dd>

                    <dt class="col-sm-5">CCCD:</dt>
                    <dd class="col-sm-7">@Model.Customer.CccdNumber</dd>

                    <dt class="col-sm-5">Địa chỉ:</dt>
                    <dd class="col-sm-7">@Model.Customer.Address</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h6>Thông tin đơn hàng</h6>
                <dl class="row">
                    <dt class="col-sm-5">Ngày bắt đầu:</dt>
                    <dd class="col-sm-7">@Model.ExpectedPickUpTime.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5">Ngày kết thúc:</dt>
                    <dd class="col-sm-7">@Model.ExpectedReturnTime.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5">Số ngày:</dt>
                    <dd class="col-sm-7">@Math.Ceiling((Model.ExpectedReturnTime - Model.ExpectedPickUpTime).TotalDays)</dd>

                    <dt class="col-sm-5">Tổng tiền:</dt>
                    <dd class="col-sm-7"><strong>@Model.TotalAmount.ToString("C")</strong></dd>
                </dl>
            </div>
        </div>

        <div class="mb-4">
            <h6>Danh sách thiết bị bàn giao</h6>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Thiết bị</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Giá/ngày</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td>@detail.Equipment.Name</td>
                            <td class="text-center">1</td>
                            <td class="text-end">@detail.UnitPriceAtBooking.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <form method="post" action="@Url.Action("ConfirmHandover", new { id = Model.Id })">
            @Html.AntiForgeryToken()

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="cccdVerified" name="cccdVerified" required>
                <label class="form-check-label" for="cccdVerified">
                    ✓ Tôi xác nhận đã kiểm tra CCCD của khách hàng và danh sách thiết bị hoàn chỉnh
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Xác nhận bàn giao
                </button>
                <a href="@Url.Action("Detail", new { id = Model.Id })" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>
