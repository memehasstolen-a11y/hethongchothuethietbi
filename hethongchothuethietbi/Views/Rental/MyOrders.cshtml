@model IEnumerable<RentalOrder>

@{
    ViewData["Title"] = "Đơn Của Tôi";
}

<h3 class="mb-4">
    <i class="bi bi-receipt"></i> Đơn Thuê Của Tôi
</h3>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày Tạo</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>
                            @{
                                var badgeColor = order.OrderStatus switch
                                {
                                    RentalOrderStatus.PendingPayment => "warning",
                                    RentalOrderStatus.Deposited => "info",
                                    RentalOrderStatus.Rented => "primary",
                                    RentalOrderStatus.Completed => "success",
                                    RentalOrderStatus.Cancelled => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@badgeColor">@order.OrderStatus.ToString()</span>
                        </td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-info" asp-action="OrderDetail" asp-route-id="@order.Id">
                                <i class="bi bi-eye"></i> Chi Tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-inbox"></i>
        <p class="mt-3 mb-0">Bạn chưa có đơn thuê nào</p>
        <a class="btn btn-primary mt-3" asp-controller="Equipment" asp-action="Index">
            <i class="bi bi-shop"></i> Bắt Đầu Thuê Thiết Bị
        </a>
    </div>
}
