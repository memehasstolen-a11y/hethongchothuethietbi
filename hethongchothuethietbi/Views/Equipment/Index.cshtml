@model IEnumerable<Equipment>

@{
    ViewData["Title"] = "Duyệt Thiết Bị";
}

<div class="mb-4">
    <h3>
        <i class="bi bi-shop"></i> Danh Sách Thiết Bị Sẵn Có
    </h3>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo tên..." value="@ViewBag.Search">
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="name" selected="@(ViewBag.Sort == "name")">Sắp xếp theo tên</option>
            <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Giá thấp nhất</option>
            <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Giá cao nhất</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-search"></i> Tìm
        </button>
    </div>
</form>

@if (Model.Any())
{
    <div class="row">
        @foreach (var equipment in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@equipment.Name</h5>
                        <p class="card-text text-muted">
                            <small>
                                <i class="bi bi-tag"></i> @equipment.Category?.Name
                            </small>
                        </p>

                        @if (!string.IsNullOrEmpty(equipment.ConditionNotes))
                        {
                            <p class="card-text">
                                <small class="text-muted">@equipment.ConditionNotes</small>
                            </p>
                        }

                        <div class="my-3">
                            <h6 class="card-subtitle">
                                <strong>@equipment.PricePerDay.ToString("N0")</strong> VNĐ/ngày
                            </h6>
                            @if (equipment.Quantity > 0)
                            {
                                <span class="badge bg-success">Còn @equipment.Quantity</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            @if (User.Identity.IsAuthenticated && !User.IsInRole("Staff") && !User.IsInRole("Admin"))
                            {
                                <!-- Chỉ Customer mới được thêm vào giỏ - dùng AJAX -->
                                <button type="button" class="btn btn-primary btn-sm w-100 add-to-cart-btn" data-equipment-id="@equipment.Id">
                                    <i class="bi bi-bag-plus"></i> Thêm Vào Giỏ
                                </button>
                            }
                            else if (User.Identity.IsAuthenticated)
                            {
                                <!-- Staff/Admin không thể thêm giỏ -->
                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                    <i class="bi bi-info-circle"></i> Chỉ Customer
                                </button>
                            }
                            else
                            {
                                <!-- Chưa login -->
                                <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div>
        @{
            var totalPages = Math.Ceiling((double)ViewBag.Total / ViewBag.PageSize);
            var currentPage = ViewBag.Page;
        }
        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1, search = ViewBag.Search, sort = ViewBag.Sort })">Đầu tiên</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = ViewBag.Search, sort = ViewBag.Sort })">Trước</a>
                        </li>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">@i</span>
                            </li>
                        }
                        else if (i >= currentPage - 2 && i <= currentPage + 2)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search, sort = ViewBag.Sort })">@i</a>
                            </li>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = ViewBag.Search, sort = ViewBag.Sort })">Sau</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = (int)totalPages, search = ViewBag.Search, sort = ViewBag.Sort })">Cuối cùng</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-inbox"></i> Không có thiết bị nào khả dụng
    </div>
}

@section Scripts {
<script>
document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.preventDefault();
        const equipmentId = this.dataset.equipmentId;
        const btn = this;

        // Tạo form tạm thời để lấy CSRF token
        const form = document.createElement('form');
        form.style.display = 'none';
        document.body.appendChild(form);

        // Tìm token từ trang
        let token = '';
        const tokenInput = document.querySelector('[name="__RequestVerificationToken"]');
        if (tokenInput) {
            token = tokenInput.value;
        }

        // Nếu không tìm được, tạo một form ẩn để lấy token
        if (!token) {
            const tempForm = document.createElement('form');
            form.innerHTML = '@Html.AntiForgeryToken()';
            token = tempForm.querySelector('[name="__RequestVerificationToken"]')?.value || '';
        }

        // Gửi AJAX request
        fetch('@Url.Action("AddToCart", "Cart")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({
                equipmentId: equipmentId,
                __RequestVerificationToken: token
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Hiển thị thông báo thành công
                btn.classList.add('btn-success');
                btn.classList.remove('btn-primary');
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Đã Thêm!';

                // Quay lại trạng thái bình thường sau 2 giây
                setTimeout(() => {
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-primary');
                    btn.innerHTML = '<i class="bi bi-bag-plus"></i> Thêm Vào Giỏ';
                }, 2000);

                // Cập nhật số lượng giỏ nếu có element hiển thị
                if (document.getElementById('cartCount')) {
                    document.getElementById('cartCount').textContent = data.cartCount;
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Có lỗi xảy ra khi thêm vào giỏ!');
        })
        .finally(() => {
            form.remove();
        });
    });
});
</script>
}

